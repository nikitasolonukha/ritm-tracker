NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Telegram secrets are server-only. Never add NEXT_PUBLIC prefixes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Explicit local demo only; never enabled on Vercel.
RITM_DEMO_MODE=0

# Optional server-only legacy journal migration owner. No automatic import for other accounts.
RITM_LEGACY_OWNER_USER_ID=
